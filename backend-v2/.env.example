# Runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# Host address used only by docker-compose.cluster.yml. Set this to the
# backend ECS private IP in production; never use 0.0.0.0 on a public host.
BACKEND_BIND_IP=127.0.0.1
# Bind address for the mTLS control plane only. This is deliberately separate
# from BACKEND_BIND_IP so exposing the certificate-gated control port never
# exposes the business API. Restrict it again in the cloud firewall.
ADMIN_BIND_IP=127.0.0.1
# Production control-plane host port. The container still listens on 8443.
ADMIN_PORT=47108
# Production must keep this true. Local docker-compose.yml overrides it to false
# and binds the control plane to 127.0.0.1 only.
ADMIN_MTLS_ENABLED=true
FRONTEND_URL=https://www.hizhuiyi.cn
BACKEND_URL=https://www.hizhuiyi.cn
SERVERLESS=false
# Comma-separated private reverse-proxy addresses. Private Docker/VPC ranges
# are trusted automatically; use this for an additional non-RFC1918 proxy.
TRUST_PROXY_IPS=
# Absolute host path used only by docker-compose.cluster.yml. It must contain
# server.crt, server.key and ca.crt; certificates are never committed.
ADMIN_CERT_DIR=

# Beijing static read-only frontend snapshots (disabled by default)
# When enabled, deploy the atomically switched STATIC_SNAPSHOT_OUTPUT_DIR/current directory.
STATIC_SNAPSHOT_ENABLED=false
STATIC_SNAPSHOT_OUTPUT_DIR=exports/static-site
# Refresh already cached Feishu document bodies at most once per this interval.
# Set to 0 to fetch only missing bodies.
STATIC_SNAPSHOT_CONTENT_REFRESH_MINUTES=360
STATIC_SNAPSHOT_RETAIN_RELEASES=3
# Optional exact HTTPS hosts whose public site or friend avatar may be downloaded
# and bundled into the snapshot. Never add private/internal hostnames.
# Example: raw.githubusercontent.com,assets.example.com
STATIC_SNAPSHOT_REMOTE_IMAGE_HOSTS=

# Host-only Beijing publisher bridge. The request directory is writable by the
# backend container; the status directory is mounted read-only. Never mount the
# publisher SSH key into the container.
STATIC_PUBLISH_REQUEST_DIR=/app/static-publish-requests
STATIC_PUBLISH_STATUS_FILE=/app/static-publish-status/status.json

# MySQL 8 / PolarDB-X (backend only)
# Replace MYSQL_USERNAME, MYSQL_URL_ENCODED_PASSWORD, and MYSQL_PRIVATE_HOST.
# Password characters such as @, #, %, /, and : must be URL-encoded.
DATABASE_URL="mysql://MYSQL_USERNAME:MYSQL_URL_ENCODED_PASSWORD@MYSQL_PRIVATE_HOST:3306/zhuiyi_blog?connection_limit=5&pool_timeout=20&sslaccept=strict"

# Application security
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com

# AgentDeck / orchestration license signing. These secrets are independent
# from JWT and card-redemption secrets. Never use a key committed to source.
LICENSE_KEY_SECRET=replace-with-an-independent-random-string-at-least-32-chars
LICENSE_ED25519_ACTIVE_KID=k1
LICENSE_ED25519_PRIVATE_KEY=
# Optional: when omitted, the server derives the public key from the private key.
LICENSE_ED25519_PUBLIC_KEY=
LICENSE_PLUGIN_PACKAGES_DIR=plugin-packages
LICENSE_PLUGIN_STAGING_DIR=plugin-staging
# Optional dedicated S3-compatible storage for device-bound plugin packages.
LICENSE_PLUGIN_OSS_ENDPOINT=
LICENSE_PLUGIN_OSS_ACCESS_KEY_ID=
LICENSE_PLUGIN_OSS_ACCESS_KEY_SECRET=
LICENSE_PLUGIN_OSS_BUCKET=
LICENSE_PLUGIN_OSS_PREFIX=plugin-packages/
LICENSE_PLUGIN_OSS_PUBLIC_ENDPOINT=
LICENSE_PLUGIN_OSS_REGION=us-east-1
LICENSE_PLUGIN_OSS_PATH_STYLE=true
# Beijing read-only frontend security bridge. Generate a random value of at
# least 32 characters and keep it out of Git. Only private proxy IPs belong here.
INTERNAL_SECURITY_SHARED_SECRET=
INTERNAL_SECURITY_PROXY_IPS=172.25.1.22

# Anonymous one-time article access. Keep the backend private and expose only
# /_access through the frontend Nginx gateway. Both secrets must be random and
# at least 32 characters; never commit their production values.
ARTICLE_ACCESS_ENABLED=false
ARTICLE_ACCESS_PEPPER=
ARTICLE_ACCESS_GATEWAY_SECRET=
ARTICLE_ACCESS_GATEWAY_PROXY_IPS=172.25.1.22
ARTICLE_ACCESS_ALLOW_LAN_GATEWAY=false
ARTICLE_ACCESS_COOKIE_NAME=zhuiyi_article_access
# Leave blank for a host-only cookie (recommended). Set .hizhuiyi.cn only if
# one anonymous grant must intentionally be shared by every trusted subdomain.
ARTICLE_ACCESS_COOKIE_DOMAIN=
ARTICLE_ACCESS_MAX_GRANT_HOURS=168

# One-time private-file redemption. CARD_REDEEM_SECRET signs download tickets
# and scopes code/request digests, so use a random value of at least 32 characters.
CARD_REDEEM_ENABLED=false
CARD_REDEEM_SECRET=
# 轮换时将退役密钥按逗号分隔保留在此；新卡始终使用当前 SECRET。
# 直到旧卡和发卡回执全部过期后才能移除对应旧密钥。
CARD_REDEEM_PREVIOUS_SECRETS=
# A lost POST response can be recovered only with the same request ID and IP.
CARD_REDEEM_REPLAY_MINUTES=30
# URL-carried internal ticket lifetime. Keep this much shorter than the replay window.
CARD_REDEEM_DOWNLOAD_TICKET_MINUTES=5
# 发卡请求超时后可凭同一 requestId 取回原批次的时长；到期后只清除加密回执，不删除卡密。
CARD_ISSUE_RECEIPT_HOURS=24
# Private local storage. Files are served only through signed download tickets.
CARD_REDEEM_FILE_DIR=cache_data/card-files
CARD_REDEEM_MAX_FILE_BYTES=536870912
# 飞书卡密同步默认关闭（卡密数据不经过飞书）；显式设 true 才会拉取/回写 CardCodes 表。
CARD_REDEEM_FEISHU_SYNC=false
# Optional private object storage (S3-compatible protocol: RainYun ROS, MinIO,
# or any AWS SigV4 endpoint). When enabled, card files are stored in the bucket
# and downloads 302-redirect to short-lived presigned URLs.
CARD_REDEEM_OSS_ENABLED=false
# 例（雨云 ROS）: https://s3.<region>.rainyun.com（以控制台显示的 S3 接入点为准）
CARD_REDEEM_OSS_ENDPOINT=
CARD_REDEEM_OSS_ACCESS_KEY_ID=
CARD_REDEEM_OSS_ACCESS_KEY_SECRET=
CARD_REDEEM_OSS_BUCKET=
CARD_REDEEM_OSS_KEY_PREFIX=card-files/
CARD_REDEEM_OSS_PUBLIC_ENDPOINT=
# 预签名 URL 是可转发的 bearer 凭据：默认 30 分钟，应用会强制上限 1 小时。
CARD_REDEEM_OSS_PRESIGN_TTL_SECONDS=1800
# SigV4 区域；雨云 ROS / MinIO 通常填 us-east-1 即可
CARD_REDEEM_OSS_REGION=us-east-1
# true = endpoint/bucket/key（第三方 S3 兼容服务与 MinIO 用 true）；false = bucket.endpoint/key
CARD_REDEEM_OSS_PATH_STYLE=true
# CardDeck 专用域名的主机名作用域：该域名只暴露发卡工作台 API（login/card-issue/card-oss），
# 其余管理功能仅经控制面域名访问。留空 = 不启用。生产建议填写，如 cardapi.hizhuiyi.cn
# 控制面是否托管 Web 管理前端。false = 只保留 API（界面由 CardDeck 软件承担）
ADMIN_FRONTEND_ENABLED=true
CARD_API_HOST=

# 全站每日下载授权字节熔断（字节）。0 = 关闭。
CARD_REDEEM_DAILY_BYTES_LIMIT=53687091200

# LLM provider (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=

# Feishu CMS and bot (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_TOKEN=
FEISHU_DATA_ENV=Production
# 迁移期仅 Production 可读取 Environment 为空的旧记录；全部标记完成后设为 false。
FEISHU_ALLOW_LEGACY_BLANK_ENV=false
# Keep enabled in production. Set false only in an isolated local stack whose
# administrators are seeded into the local MySQL database.
ADMIN_FEISHU_PRECHECK_ENABLED=true
FEISHU_CHAT_ID=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
FEISHU_ERROR_WEBHOOK_URL=
FEISHU_ERROR_WEBHOOK_SECRET=
FEISHU_POSTS_TABLE_ID=
FEISHU_ADMINS_TABLE_ID=
FEISHU_IP_WHITELIST_TABLE_ID=
FEISHU_USERS_TABLE_ID=
FEISHU_COMMENTS_TABLE_ID=
FEISHU_FRIENDS_TABLE_ID=
FEISHU_REQUESTS_TABLE_ID=
FEISHU_ARTICLE_ACCESS_CODES_TABLE_ID=
FEISHU_CARD_CODES_TABLE_ID=
FEISHU_FEEDBACK_TABLE_ID=
FEISHU_PROJECTS_TABLE_ID=
FEISHU_CONFIG_TABLE_ID=
FEISHU_TIMELINE_TABLE_ID=
FEISHU_ALBUM_TABLE_ID=
FEISHU_I18N_DICT_TABLE_ID=

# Keep rate limits enabled, but only opt in to persistent automatic IP bans
# after the reverse-proxy chain has been verified to carry each visitor IP.
RATE_LIMIT_AUTO_BAN=false
# Comma-separated proxy addresses that must never be treated as visitor IPs.
IP_BLACKLIST_EXEMPT_IPS=
# Comma-separated HTTPS hostnames that may be used as external feature-preview
# pages in the product vote. Administrators can configure only paths below
# these hosts; the default is preview.hizhuiyi.cn.
PREVIEW_ALLOWED_HOSTS=preview.hizhuiyi.cn
FEISHU_BLACKLIST_TABLE_ID=
FEISHU_DANMAKU_TABLE_ID=
FEISHU_AUDIT_LOGS_TABLE_ID=

# Aliyun DirectMail (optional, port 465 enables SSL)
SMTP_ENABLED=false
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=your-sender-address@example.com
SMTP_PASS=your-aliyun-smtp-password
SMTP_FROM='"ZhuiYi Blog" <your-sender-address@example.com>'

# Aliyun OSS (optional)
# Disabled by default. It is enabled only when this flag is true and all
# credentials below are complete; otherwise image uploads use cache_data/uploads.
OSS_ENABLED=false
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_CDN_DOMAIN=

# Local image persistent-volume safety limits (bytes are decimal integers)
LOCAL_IMAGE_MAX_FILES=2000
LOCAL_IMAGE_MAX_TOTAL_BYTES=2147483648
LOCAL_IMAGE_MIN_FREE_BYTES=2147483648

# 飞书生活相册下载后会移除 EXIF/GPS，生成展示图和缩略图并写入持久卷。
ALBUM_MAX_SOURCE_BYTES=15728640
ALBUM_MAX_INPUT_PIXELS=40000000
ALBUM_MAX_FILES=6000
ALBUM_DISPLAY_MAX_TOTAL_BYTES=8589934592
ALBUM_THUMBNAIL_MAX_TOTAL_BYTES=2147483648
ALBUM_MIN_FREE_BYTES=8589934592

# OAuth providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional GitHub-only outbound mTLS proxy. The proxy certificate must include
# its DNS hostname as a SAN. Leave MTLS_PROXY_SERVER_CA_CERT_PATH empty only
# when the proxy uses a public CA; otherwise set it to the dedicated private
# server CA. Never commit any certificate private key.
MTLS_PROXY_ENABLED=false
GITHUB_PROXY_BASE=
GITHUB_API_PROXY_BASE=
MTLS_CLIENT_CERT_PATH=
MTLS_CLIENT_KEY_PATH=
MTLS_PROXY_SERVER_CA_CERT_PATH=
# Absolute host directory mounted read-only to /app/proxy-mtls by the cluster
# compose files. It contains client.crt and client.key only.
PROXY_MTLS_CERT_DIR=

# Optional control-plane monitoring. Each URL is fixed by the operator and is
# called only from the backend; do not accept monitor URLs from browsers.
# Health endpoints should return HTTP 200 and their own X-Zhuiyi-Node header.
MONITOR_BEIJING_STATIC_HEALTH_URL=
MONITOR_HK_DYNAMIC_HEALTH_URL=
MONITOR_HK_DYNAMIC_HEALTH_CONNECT_IP=
MONITOR_CLOUDFLARE_HEALTH_URL=
