# Leave blank to use the same origin and Vite's local /api proxy.
VITE_API_BASE_URL=
VITE_SOCKET_BASE_URL=
VITE_SITE_URL=https://www.hizhuiyi.cn

# Use "static" for the Beijing read-only frontend. The default interactive mode
# keeps the existing Hong Kong frontend behavior.
VITE_SITE_MODE=interactive
VITE_STATIC_DATA_BASE=/data/live

# Optional CDN-backed post cache.
VITE_USE_CDN_CACHE=false
VITE_CDN_BASE_URL=

# Card redemption is available at /card during local development. Add the
# dedicated host here so the same build opens the standalone redemption page
# at that host without changing the blog routes.
VITE_CARD_HOSTS=card.hizhuiyi.cn,card.localhost
VITE_CARD_REDEEM_ENABLED=false
VITE_CARD_SITE_URL=
VITE_BLOG_HOME_URL=/

# Optional build metadata.
VITE_DEPLOY_DATE=
